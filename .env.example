# Bu dosyayı .env olarak kopyalayıp değerleri kendi değerlerinizle değiştirin. .env git'e eklenmez.
# SA parolası SQL Server karmaşıklık kurallarını sağlamalıdır (büyük/küçük harf, rakam, sembol; en az 8 karakter).
SA_PASSWORD=Degistir-Beni-1!
# En az 32 karakter rastgele bir dize:  openssl rand -base64 48
JWT_SECRET=degistir-beni-en-az-32-karakterlik-rastgele-bir-dize
ADMIN_PASSWORD=degistir-beni-admin
OPERATOR_PASSWORD=degistir-beni-operator
# true: ilk açılışta boş veritabanına 48 saatlik sentetik demo verisi yükler
SEED_DEMO_DATA=true
