@model Dashboard
@{
    ViewData["Title"] = "Panel";
    var now = DateTime.UtcNow;
    int Count(string key) => Model.Assets.ByHealth.TryGetValue(key, out var n) ? n : 0;
    int Open(string key) => Model.OpenAlerts.TryGetValue(key, out var n) ? n : 0;
    var openTotal = Model.OpenAlerts.Values.Sum();
    var kpis = new (string Key, string Label, string Css)[]
    {
        ("Critical", "Kritik", "kpi-critical"), ("Warning", "Uyarı", "kpi-warning"),
        ("NoData", "Veri yok", "kpi-nodata"), ("Normal", "Normal", "kpi-normal"),
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Genel durum</h1>
        <div class="text-body-secondary small">Son güncelleme: @Display.Local(now, "HH:mm:ss") · <span id="refresh-note" data-refresh-seconds="30">30 sn'de bir yenilenir</span></div>
    </div>
    <a class="btn btn-outline-primary btn-sm" asp-action="Index">Yenile</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <a class="ap-kpi kpi-total" asp-controller="Assets" asp-action="Index">
            <span class="ap-kpi-value">@Model.Assets.Total</span><span class="ap-kpi-label">Toplam varlık</span>
        </a>
    </div>
    @foreach (var k in kpis)
    {
        <div class="col-6 col-lg-2">
            <a class="ap-kpi @k.Css" asp-controller="Assets" asp-action="Index" asp-route-health="@k.Key">
                <span class="ap-kpi-value">@Count(k.Key)</span><span class="ap-kpi-label">@k.Label</span>
            </a>
        </div>
    }
    <div class="col-12 col-lg-2">
        <a class="ap-kpi kpi-alerts" asp-controller="Alerts" asp-action="Index" asp-route-status="open">
            <span class="ap-kpi-value">@openTotal</span><span class="ap-kpi-label">Açık alarm</span>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card ap-card h-100">
            <div class="card-header">Sağlık dağılımı</div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                @if (Model.Assets.Total == 0)
                {
                    <p class="text-body-secondary mb-0">Henüz varlık yok.</p>
                }
                else
                {
                    <div class="ap-donut"><canvas id="health-chart" data-labels="Kritik,Uyarı,Veri yok,Normal"
                        data-values="@Count("Critical"),@Count("Warning"),@Count("NoData"),@Count("Normal")" aria-label="Varlık sağlık dağılımı" role="img"></canvas></div>
                    <div class="small text-body-secondary mt-3">
                        Açık alarmlar: <span class="text-danger fw-semibold">@Open("Critical") kritik</span> ·
                        <span class="text-warning-emphasis fw-semibold">@Open("Warning") uyarı</span>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card ap-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>İlgi gerektiren varlıklar</span>
                <span class="badge text-bg-secondary">@Model.Attention.Count</span>
            </div>
            @if (Model.Attention.Count == 0)
            {
                <div class="card-body text-body-secondary">Tüm varlıklar normal çalışıyor. 👍</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var a in Model.Attention)
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" asp-controller="Assets" asp-action="Details" asp-route-id="@a.Id">
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate">@a.Name</div>
                                <div class="small text-body-secondary text-truncate">@a.Code · @Display.CategoryLabel(a.Category)@(a.Location is null ? "" : " · " + a.Location)</div>
                            </div>
                            <div class="text-end flex-shrink-0">
                                <span class="badge @Display.HealthBadge(a.Health)">@Display.HealthLabel(a.Health)</span>
                                <div class="small text-body-secondary mt-1">
                                    @if (a.OpenAlerts > 0) { <span>@a.OpenAlerts açık alarm · </span> }son ölçüm @Display.Ago(a.LastReadingAt, now)
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="card ap-card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Son açık alarmlar</span>
        <a class="small text-decoration-none" asp-controller="Alerts" asp-action="Index" asp-route-status="open">Tümünü gör →</a>
    </div>
    @if (Model.LatestOpenAlerts.Count == 0)
    {
        <div class="card-body text-body-secondary">Açık alarm yok.</div>
    }
    else
    {
        @await Html.PartialAsync("_AlertTable", (IReadOnlyList<AlertItem>)Model.LatestOpenAlerts)
    }
</div>

@await Html.PartialAsync("_AckModal")
