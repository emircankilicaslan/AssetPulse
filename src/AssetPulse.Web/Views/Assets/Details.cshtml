@using System.Text.Json
@model AssetDetailModel
@{
    var a = Model.Asset;
    ViewData["Title"] = a.Name;
    var now = DateTime.UtcNow;
    var isAdmin = User.IsInRole("Admin");
}
<nav aria-label="breadcrumb"><ol class="breadcrumb small">
    <li class="breadcrumb-item"><a asp-action="Index">Varlıklar</a></li>
    <li class="breadcrumb-item active" aria-current="page">@a.Code</li>
</ol></nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 mb-0">@a.Name</h1>
            <span class="badge @Display.HealthBadge(Model.Health)">@Display.HealthLabel(Model.Health)</span>
        </div>
        <div class="text-body-secondary">
            @a.Code · @Display.CategoryLabel(a.Category)@(a.Location is null ? "" : " · " + a.Location) · eklenme @Display.Local(a.CreatedAt, "dd.MM.yyyy")
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#sensor-modal">+ Sensör</button>
            <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#rule-modal" @(a.Sensors.Count == 0 ? "disabled" : null)>+ Alarm kuralı</button>
            <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#key-modal">Cihaz anahtarını yenile</button>
        </div>
    }
</div>

@if (a.Sensors.Count == 0)
{
    <div class="card ap-card mb-4"><div class="card-body text-body-secondary">Bu varlığa henüz sensör eklenmemiş.</div></div>
}
<div class="row g-4 mb-4">
    @foreach (var s in a.Sensors)
    {
        var rules = s.Rules.Where(r => r.IsActive).ToList();
        var thresholds = JsonSerializer.Serialize(rules.Select(r => new { kind = r.Kind, value = r.Threshold, severity = r.Severity }));
        <div class="col-12 col-xl-6">
            <div class="card ap-card h-100 sensor-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="fw-semibold">@s.Name</div>
                            <div class="small text-body-secondary">@s.Code</div>
                        </div>
                        <div class="text-end">
                            <div class="ap-reading">@Display.Number(s.LastValue) <span class="ap-unit">@s.Unit</span></div>
                            <div class="small text-body-secondary">@Display.Ago(s.LastMeasuredAt, now)</div>
                        </div>
                    </div>
                    <div class="btn-group btn-group-sm my-3 range-group" role="group" aria-label="Zaman aralığı">
                        <button type="button" class="btn btn-outline-secondary range-btn active" data-range="24h">24 saat</button>
                        <button type="button" class="btn btn-outline-secondary range-btn" data-range="7d">7 gün</button>
                        <button type="button" class="btn btn-outline-secondary range-btn" data-range="30d">30 gün</button>
                    </div>
                    <div class="ap-chart"><canvas class="sensor-chart" data-asset="@a.Id" data-sensor="@s.Code" data-unit="@s.Unit" data-thresholds="@thresholds" role="img" aria-label="@s.Name zaman serisi"></canvas></div>
                    <div class="small text-body-secondary mt-2 chart-note"></div>
                    @if (rules.Count > 0)
                    {
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            @foreach (var r in rules)
                            {
                                <span class="badge rule-chip rule-@r.Severity.ToLowerInvariant()" title="@Display.SeverityLabel(r.Severity) alarm kuralı">@Display.SeverityLabel(r.Severity): @Display.RuleText(r, s.Unit)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="small text-body-secondary mt-3">Bu sensör için alarm kuralı tanımlı değil.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="card ap-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Bu varlığın alarmları</span>
        <span class="small text-body-secondary">son @Model.Alerts.Items.Count / toplam @Model.Alerts.Total</span>
    </div>
    @if (Model.Alerts.Items.Count == 0)
    {
        <div class="card-body text-body-secondary">Bu varlık için alarm kaydı yok.</div>
    }
    else
    {
        @await Html.PartialAsync("_AlertTable", (IReadOnlyList<AlertItem>)Model.Alerts.Items)
    }
</div>

@await Html.PartialAsync("_AckModal")

@if (isAdmin)
{
    <div class="modal fade" id="sensor-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-action="AddSensor" asp-route-id="@a.Id">
                <div class="modal-header"><h2 class="modal-title fs-5">Sensör ekle</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label" for="s-code">Kod</label><input class="form-control" id="s-code" name="code" required pattern="[A-Za-z0-9][A-Za-z0-9._-]{1,39}" placeholder="oil-temp" /></div>
                    <div class="mb-3"><label class="form-label" for="s-name">Ad</label><input class="form-control" id="s-name" name="name" required maxlength="120" placeholder="Yağ sıcaklığı" /></div>
                    <div class="mb-0"><label class="form-label" for="s-unit">Birim</label><input class="form-control" id="s-unit" name="unit" required maxlength="16" placeholder="°C" /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="submit" class="btn btn-primary">Ekle</button></div>
            </form>
        </div>
    </div>
    <div class="modal fade" id="rule-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-action="AddRule" asp-route-id="@a.Id">
                <div class="modal-header"><h2 class="modal-title fs-5">Alarm kuralı ekle</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label" for="r-sensor">Sensör</label>
                        <select class="form-select" id="r-sensor" name="sensorId">@foreach (var s in a.Sensors) { <option value="@s.Id">@s.Name (@s.Unit)</option> }</select></div>
                    <div class="row g-3 mb-3">
                        <div class="col-6"><label class="form-label" for="r-kind">Tür</label>
                            <select class="form-select" id="r-kind" name="kind"><option value="UpperLimit">Üst sınır (&gt;)</option><option value="LowerLimit">Alt sınır (&lt;)</option></select></div>
                        <div class="col-6"><label class="form-label" for="r-th">Eşik</label><input class="form-control" id="r-th" name="threshold" type="number" step="any" required /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6"><label class="form-label" for="r-hy">Histerezis</label><input class="form-control" id="r-hy" name="hysteresis" type="number" step="any" min="0" value="0" /></div>
                        <div class="col-6"><label class="form-label" for="r-cc">Art arda ihlal</label><input class="form-control" id="r-cc" name="consecutiveCount" type="number" min="1" max="1000" value="1" /></div>
                    </div>
                    <div class="mb-0"><label class="form-label" for="r-sev">Önem</label>
                        <select class="form-select" id="r-sev" name="severity"><option value="Warning">Uyarı</option><option value="Critical">Kritik</option><option value="Info">Bilgi</option></select></div>
                    <p class="form-text mt-3 mb-0">Alarm, değer eşiği art arda belirtilen sayıda aşınca açılır; histerezis kadar güvenli tarafa dönünce kapanır.</p>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="submit" class="btn btn-primary">Ekle</button></div>
            </form>
        </div>
    </div>
    <div class="modal fade" id="key-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-action="RotateKey" asp-route-id="@a.Id">
                <div class="modal-header"><h2 class="modal-title fs-5">Cihaz anahtarını yenile</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body">Eski anahtar <strong>hemen geçersiz</strong> olur; cihazın yeni anahtarla yeniden yapılandırılması gerekir. Yeni anahtar yalnızca bir kez gösterilir.</div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="submit" class="btn btn-danger">Yenile</button></div>
            </form>
        </div>
    </div>
}
