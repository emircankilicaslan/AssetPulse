@model IReadOnlyList<AlertItem>
@* Alarm tablosu: panelde, varlık sayfasında ve alarm listesinde ortak kullanılır.
   Dar ekranlarda (site.css) satırlar, data-label değerlerini etiket olarak kullanan kartlara dönüşür. *@
@{
    var now = DateTime.UtcNow;
    var canAck = ViewData["CanAck"] as bool? ?? true;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="table-responsive">
    <table class="table table-hover align-middle ap-table mb-0">
        <thead>
            <tr>
                <th>Önem</th><th>Varlık / Sensör</th><th>Değer</th><th>Açılış</th><th>Durum</th>
                @if (canAck) { <th class="text-end">İşlem</th> }
            </tr>
        </thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td data-label="Önem"><div class="ap-cell"><span class="badge @Display.SeverityBadge(a.Severity)">@Display.SeverityLabel(a.Severity)</span></div></td>
                <td data-label="Varlık / Sensör">
                    <div class="ap-cell">
                        <a class="fw-semibold text-decoration-none" asp-controller="Assets" asp-action="Details" asp-route-id="@a.AssetId">@a.AssetName</a>
                        <div class="small text-body-secondary">@a.SensorCode</div>
                    </div>
                </td>
                <td data-label="Değer">
                    <div class="ap-cell">
                        <span class="fw-semibold">@Display.Number(a.OpenValue) @a.Unit</span>
                        <div class="small text-body-secondary">eşik @Display.Limit(a.Kind, a.Threshold, a.Unit)</div>
                    </div>
                </td>
                <td data-label="Açılış">
                    <div class="ap-cell">
                        @Display.Local(a.OpenedAt)
                        <div class="small text-body-secondary">@(a.Status == "Cleared" ? "süre " + Display.Duration(a.OpenedAt, a.ClearedAt) : Display.Ago(a.OpenedAt, now))</div>
                    </div>
                </td>
                <td data-label="Durum">
                    <div class="ap-cell">
                        <span class="badge @Display.StatusBadge(a.Status)">@Display.StatusLabel(a.Status)</span>
                        @if (a.AcknowledgedBy is not null)
                        {
                            <div class="small text-body-secondary" title="@a.Note">@a.AcknowledgedBy</div>
                        }
                    </div>
                </td>
                @if (canAck)
                {
                    <td class="text-end ap-actions">
                        @if (a.Status == "Active")
                        {
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#ack-modal"
                                    data-alert-id="@a.Id" data-alert-title="@a.AssetName · @a.SensorCode" data-return-url="@returnUrl">Üstlen</button>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
