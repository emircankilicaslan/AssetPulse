@model AlertsIndexModel
@{
    ViewData["Title"] = "Alarmlar";
    var data = Model.Page;
    var statuses = new (string? Value, string Label)[] { ("open", "Açık (aktif + üstlenilmiş)"), (null, "Tümü"), ("Active", "Aktif"), ("Acknowledged", "Üstlenildi"), ("Cleared", "Kapandı") };
    var severities = new (string? Value, string Label)[] { (null, "Tüm önemler"), ("Critical", "Kritik"), ("Warning", "Uyarı"), ("Info", "Bilgi") };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1 class="h3 mb-0">Alarmlar</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Export" asp-route-status="@Model.Status" asp-route-severity="@Model.Severity">CSV indir</a>
</div>

<form class="card ap-card mb-3" method="get" asp-action="Index">
    <div class="card-body row g-2 align-items-end">
        <div class="col-sm-5 col-md-4">
            <label class="form-label small mb-1" for="f-status">Durum</label>
            <select class="form-select form-select-sm" id="f-status" name="status">
                @foreach (var (value, label) in statuses) { <option value="@value" selected="@(Model.Status == value)">@label</option> }
            </select>
        </div>
        <div class="col-sm-4 col-md-3">
            <label class="form-label small mb-1" for="f-sev">Önem</label>
            <select class="form-select form-select-sm" id="f-sev" name="severity">
                @foreach (var (value, label) in severities) { <option value="@value" selected="@(Model.Severity == value)">@label</option> }
            </select>
        </div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" type="submit">Süz</button></div>
        <div class="col text-end small text-body-secondary">@data.Total kayıt</div>
    </div>
</form>

<div class="card ap-card">
    @if (data.Items.Count == 0)
    {
        <div class="card-body text-body-secondary">Bu süzgece uyan alarm yok.</div>
    }
    else
    {
        @await Html.PartialAsync("_AlertTable", (IReadOnlyList<AlertItem>)data.Items)
    }
</div>

@if (data.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Sayfalar">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(data.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-severity="@Model.Severity" asp-route-page="@(data.Page - 1)">‹ Önceki</a>
            </li>
            @for (var p = Math.Max(1, data.Page - 2); p <= Math.Min(data.TotalPages, data.Page + 2); p++)
            {
                <li class="page-item @(p == data.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-severity="@Model.Severity" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(data.Page >= data.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-severity="@Model.Severity" asp-route-page="@(data.Page + 1)">Sonraki ›</a>
            </li>
        </ul>
    </nav>
}

@await Html.PartialAsync("_AckModal")
